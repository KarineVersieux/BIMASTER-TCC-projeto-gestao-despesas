# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NÃO deve ser enviado ao GitHub.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_KEY=COLE_A_CHAVE_DO_SUPABASE
SUPABASE_DB_URI=postgresql://USUARIO:SENHA@HOST:6543/postgres

CHAVE_API_GEMINI=COLE_A_CHAVE_DO_GEMINI

DB_NAME=postgres
DB_USER=USUARIO_DO_POSTGRES
DB_PASSWORD=SENHA_DO_POSTGRES
DB_HOST=HOST_DO_POSTGRES
DB_PORT=6543

SQL_LLM_MODEL=gemini-3.5-flash-lite
EXTRACT_LLM_MODEL=gemini-3.5-flash
